<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/segtium_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_yellow"
            android:padding="20dp"
            android:src="@drawable/ic_contact"
            app:tint="@color/segtium_navy" />

        <TextView
            android:id="@+id/tvInactiveDetailNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Trabajador"
            android:textColor="@color/segtium_navy"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvInactiveDetailArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área: ---"
            android:textColor="@color/gray_text"
            android:textSize="18sp"
            android:layout_marginTop="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información de la Cuenta"
                    android:textStyle="bold"
                    android:textColor="@color/segtium_navy"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvInactiveDetailEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="correo@segtium.com"
                    android:textColor="@color/black"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvInactiveDetailEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Dado de Baja"
                    android:textColor="#D32F2F"
                    android:textStyle="italic"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acciones Disponibles"
            android:textColor="@color/segtium_navy"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnReactivar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Reactivar y Regresar a la Lista"
            android:backgroundTint="@color/segtium_navy"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnEliminarPermanente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Eliminar del Sistema"
            android:backgroundTint="#D32F2F"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            android:layout_marginTop="16dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* Eliminar al usuario borrará todos sus datos permanentemente"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
