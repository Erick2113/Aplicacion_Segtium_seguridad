<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/segtium_cream">

    <com.example.wearableseguridad.CurvedImageView
        android:id="@+id/curvedHeaderLogin"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:src="@drawable/imagenregistro" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivLogoLogin"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="240dp"
            android:src="@drawable/logoapp"
            android:elevation="4dp"
            android:contentDescription="Logo Segtium"/>

        <TextView
            android:id="@+id/tvAppNameLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEGTIUM"
            android:textColor="@color/segtium_navy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvAppSubtitleLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEGURIDAD LABORAL"
            android:textColor="@color/segtium_navy"
            android:textSize="14sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvWelcomeLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIENVENIDO"
            android:textColor="@color/segtium_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicia sesión para continuar"
            android:textColor="@color/segtium_navy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Correo electrónico"
            android:textColor="@color/black"
            android:textColorHint="#999999"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="15dp"
            android:inputType="textEmailAddress"
            android:elevation="2dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Contraseña"
            android:textColor="@color/black"
            android:textColorHint="#999999"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="25dp"
            android:inputType="textPassword"
            android:elevation="2dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Iniciar sesión"
            android:backgroundTint="@color/segtium_navy"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</RelativeLayout>