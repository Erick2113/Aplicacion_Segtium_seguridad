<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/segtium_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes de Usuario"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/segtium_navy"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notificaciones y Sonidos"
                    android:textStyle="bold"
                    android:textColor="@color/segtium_navy"
                    android:layout_marginBottom="12dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWorkerNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notificaciones de Seguridad"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    app:thumbTint="@color/segtium_navy"
                    app:trackTint="#B0BEC5" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWorkerVibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vibración en Alertas"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    app:thumbTint="@color/segtium_navy"
                    app:trackTint="#B0BEC5" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginVertical="12dp"/>

                <TextView
                    android:id="@+id/tvSelectedTone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tono: Predeterminado"
                    android:textSize="14sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnSelectTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Tono"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/segtium_navy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/segtium_navy" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seguridad"
                    android:textStyle="bold"
                    android:textColor="@color/segtium_navy"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnWorkerChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cambiar mi Contraseña"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/segtium_navy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/segtium_navy" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuenta"
                    android:textStyle="bold"
                    android:textColor="@color/segtium_navy"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvWorkerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="correo@segtium.com"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnWorkerLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cerrar Sesión"
                    android:backgroundTint="#607D8B"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>